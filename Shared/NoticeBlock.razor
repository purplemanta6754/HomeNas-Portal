<div class="alert alert-secondary mt-4">
    <i class="bi bi-info-circle-fill"></i>
    <strong>@Title</strong>

    <span class="text-nowrap">
        <br />
        Cualquier característica de esta versión puede que sea modificada o no implementada<br />
        en la versión final. Además es probable que el portal no funcione como lo esperado.<br /><br />
        Usálo bajo tu propia discreción.
    </span>
</div>

@code {
    // Demonstrates how a parent component can supply parameters
    [Parameter]
    public string? Title { get; set; }
}
