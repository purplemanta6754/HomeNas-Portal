@page "/storage"

<PageTitle>HomeNAS Portal — Mi nube</PageTitle>

<h1>Mi nube</h1>
<p>Elija lo que desee realizar con su servidor:</p>

<div class="row">
  <div class="card" style="width: 18rem;">
    <img src=".../assets/img/storageSection/tools.png" class="card-img-top" alt="...">
    <div class="card-body">
      <h5 class="card-title">Ajustes de la nube</h5>
      <p class="card-text">Cambie y personalice la configuración de su nube.</p>
      <a href="#" class="btn btn-primary">Entrar a Ajustes</a>
    </div>
  </div>
  <div class="card" style="width: 18rem;">
    <img src=".../assets/img/storageSection/cloud-archive.png" class="card-img-top" alt="...">
    <div class="card-body">
      <h5 class="card-title">Acceder a la nube</h5>
      <p class="card-text">Gestione sus archivos almacenados en el servidor.</p>
      <a href="#" class="btn btn-primary"><i class="bi bi-box-arrow-up-right"></i> Visitar mi nube</a>
    </div>
  </div>
</div>

